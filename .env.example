# ─────────────────────────────────────────────────────────────
# FabricView · configuración
# Copia este fichero a .env (o ejecuta scripts/init-env.sh, que
# rellena los secretos automáticamente). No subas .env a git.
# ─────────────────────────────────────────────────────────────

# Versión de las imágenes a ejecutar (la cambia scripts/update.sh)
FABRIC_VERSION=0.1.0
# Registro de imágenes (GitHub Container Registry de tu cuenta u organización)
FABRIC_REGISTRY=ghcr.io/tapionsky
# Actualizaciones: "registry" (descarga imágenes publicadas, recomendado) o "build" (compila en el servidor)
FABRIC_UPDATE_MODE=registry

# Modo demo: 1 = equipos y métricas simulados, sin hardware
FABRIC_DEMO=0

# Secreto maestro (≥ 32 caracteres). Cifra credenciales y firma sesiones.
# ¡Si lo pierdes o lo cambias, las credenciales guardadas dejan de poder leerse!
# Genera uno con: openssl rand -base64 48
FABRIC_SECRET_KEY=

# Nombres que se muestran en la interfaz
FABRIC_TENANT_NAME=Mi empresa
FABRIC_SITE_NAME=Sede Central
TZ=Europe/Madrid

# Primer administrador (solo se crea si no hay usuarios).
# Si dejas la contraseña vacía se genera una y se muestra UNA vez en: docker compose logs api
FABRIC_ADMIN_EMAIL=admin@fabricview.local
FABRIC_ADMIN_PASSWORD=

# Sesiones
FABRIC_SESSION_HOURS=12
FABRIC_SESSION_REMEMBER_DAYS=30
FABRIC_LOG_LEVEL=INFO

# Base de datos (PostgreSQL + TimescaleDB, contenedor "db")
POSTGRES_DB=fabricview
POSTGRES_USER=fabricview
POSTGRES_PASSWORD=

# Acceso web (proxy Caddy)
FABRIC_HTTP_PORT=80
FABRIC_HTTPS_PORT=443
# HTTP simple en la red de gestión:
FABRIC_CADDYFILE=Caddyfile
FABRIC_SITE_ADDRESS=:80
# HTTPS: FABRIC_CADDYFILE=Caddyfile.https, FABRIC_SITE_ADDRESS=fabricview.midominio.local
# y FABRIC_TLS=internal (CA interna) o tu correo (Let's Encrypt)
FABRIC_TLS=internal
