# Proxy por HTTP (red de gestión interna). Para HTTPS usa Caddyfile.https
# (FABRIC_CADDYFILE=Caddyfile.https en .env).
{
	# Solo la API de Vyntralo llega a este socket (volumen «proxy» compartido): así puede
	# cargar el certificado HTTPS que se sube desde Sistema › Certificado HTTPS.
	admin unix//proxy/admin.sock|0666
	grace_period 10s
}

(fabricview) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

{$FABRIC_SITE_ADDRESS::80} {
	import fabricview
}
